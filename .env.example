# Copy to .env (gitignored) and fill in
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

DB_NAME=photorepo
DB_USER=photorepo
DB_PASSWORD=change-me

# Host login: used to create events on /host and to view /admin/metrics. Use a long, unique password
ADMIN_PASSWORD=change-me

# Public address guests use, for the QR code on /share. Leave unset locally; set it on EC2
# PUBLIC_URL=http://<ec2-public-ip>:3000

# Which compose files plain `docker compose ...` commands use. Keep ONE of these uncommented.
COMPOSE_PATH_SEPARATOR=;
# Docker Desktop (Windows/macOS):
COMPOSE_FILE=compose.yaml;compose.monitoring.yaml;compose.desktop.yaml
# Linux server (EC2):
# COMPOSE_FILE=compose.yaml;compose.monitoring.yaml
